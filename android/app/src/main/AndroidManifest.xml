<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for API calls and Play-featured network access in release builds
         (debug manifest alone is not merged into release). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ notification permission (FCM / local notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for Google Play Billing (Musamimuk Coins IAP). -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- App does not use advertising ID — strip AD_ID if any dependency merges it in. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Saving designs to gallery (gal package; API 29 and below). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <application
        android:label="Musamimuk"
        android:name="${applicationName}"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Custom scheme: musamimuk://contest/12 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="musamimuk" />
            </intent-filter>

            <!-- HTTPS App Links (verified hosts → open app when installed).
                 Host these paths on the website; unverified clicks open the
                 web landing page which redirects to Play Store. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="srv1813447.hstgr.cloud" android:pathPrefix="/open" />
                <data android:scheme="https" android:host="srv1813447.hstgr.cloud" android:pathPrefix="/app" />
                <data android:scheme="https" android:host="srv1813447.hstgr.cloud" android:pathPrefix="/contest" />
                <data android:scheme="https" android:host="srv1813447.hstgr.cloud" android:pathPrefix="/contests" />
                <data android:scheme="https" android:host="srv1813447.hstgr.cloud" android:pathPrefix="/share" />
                <data android:scheme="https" android:host="srv1813447.hstgr.cloud" android:pathPrefix="/s" />
                <data android:scheme="https" android:host="srv1813447.hstgr.cloud" android:pathPrefix="/feed" />
                <data android:scheme="https" android:host="musamimuk.app" android:pathPrefix="/open" />
                <data android:scheme="https" android:host="musamimuk.app" android:pathPrefix="/app" />
                <data android:scheme="https" android:host="musamimuk.app" android:pathPrefix="/contest" />
                <data android:scheme="https" android:host="musamimuk.app" android:pathPrefix="/contests" />
                <data android:scheme="https" android:host="musamimuk.app" android:pathPrefix="/share" />
                <data android:scheme="https" android:host="musamimuk.app" android:pathPrefix="/s" />
                <data android:scheme="https" android:host="www.musamimuk.app" android:pathPrefix="/open" />
                <data android:scheme="https" android:host="www.musamimuk.app" android:pathPrefix="/contest" />
                <data android:scheme="https" android:host="www.musamimuk.app" android:pathPrefix="/share" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Google Maps SDK (value from android/local.properties GOOGLE_MAPS_API_KEY). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <!-- Default FCM notification channel (must match PushNotificationService). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="musamimuk_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- Facebook Login (flutter_facebook_auth) -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.ApplicationName"
            android:value="@string/facebook_display_name" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />

        <activity
            android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:label="@string/facebook_display_name" />
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- https://pub.dev/packages/url_launcher#android -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Google Sign-In (package visibility, API 30+) -->
        <package android:name="com.google.android.gms" />
        <!-- Facebook Login (package visibility, API 30+) -->
        <package android:name="com.facebook.katana" />
        <provider android:authorities="com.facebook.katana.provider.PlatformProvider" />
    </queries>
</manifest>
